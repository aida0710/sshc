{
  "name": "sshc",
  "productName": "sshc",
  "desktopName": "com.github.aida0710.sshc.desktop",
  "version": "0.1.0",
  "private": true,
  "author": "aida0710",
  "description": "The desktop shell for sshc",
  "main": "out/main.js",
  "scripts": {
    "postinstall": "install-electron",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test --enable-source-maps out/entrance.test.js out/reopen.test.js out/lifecycle.test.js out/install-cli.test.js out/launcher.test.js out/installer.test.js out/paths.test.js",
    "icons": "npm run build && node out/icon.mjs",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.github.aida0710.sshc",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/*.js",
      "out/*.js.map",
      "!out/*.test.js",
      "!out/*.test.js.map",
      "!out/adhoc.js",
      "!out/adhoc.js.map",
      "build/icon.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png"
    ],
    "extraResources": [
      {
        "from": "resources/${os}-${arch}/sshc",
        "to": "sshc"
      }
    ],
    "mac": {
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "desktop": {
        "entry": {
          "Name": "sshc",
          "Comment": "Manage OpenSSH configuration and connect from one window"
        }
      },
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${os}-${arch}-setup.${ext}",
      "signAndEditExecutable": true,
      "extraResources": [
        {
          "from": "resources/win32-${arch}/sshc.exe",
          "to": "cli/sshc.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": false
    },
    "afterPack": "./out/adhoc.js"
  }
}
