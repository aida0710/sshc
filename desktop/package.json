{
  "name": "sshc-desktop",
  "productName": "sshc",
  "desktopName": "com.github.aida0710.sshc.desktop",
  "version": "0.1.0",
  "private": true,
  "author": "aida0710",
  "description": "The desktop shell for sshc",
  "main": "main.js",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "dist": "electron-builder --mac --linux",
    "test": "node --test entrance.test.js reopen.test.js lifecycle.test.js install-cli.test.js launcher.test.js",
    "icons": "node icon.mjs"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.github.aida0710.sshc",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "lifecycle.js",
      "preload.js",
      "install-cli.js",
      "launcher.js",
      "entrance.js",
      "reopen.js",
      "tray.js",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png"
    ],
    "extraResources": [
      {
        "from": "resources/${os}-${arch}/sshc",
        "to": "sshc"
      }
    ],
    "mac": {
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "desktop": {
        "entry": {
          "Name": "sshc",
          "Comment": "Manage OpenSSH configuration and connect from one window"
        }
      },
      "icon": "build/icon.png"
    }
  }
}
