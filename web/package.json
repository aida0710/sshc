{
  "name": "sshc-web",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "test": "vitest run",
    "check:i18n": "vitest run src/i18n/catalogue.test.ts --reporter=verbose",
    "typecheck": "tsc -b --force --pretty false && tsc -p tsconfig.e2e.json --pretty false",
    "lint": "eslint src e2e playwright.config.ts vite.config.ts vitest.setup.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "monaco-editor": "0.56.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "8.1.5",
    "vitest": "4.1.1"
  },
  "overrides": {
    "dompurify": "3.4.14",
    "js-yaml": "4.3.1"
  }
}
